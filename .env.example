APP_NAME=TaskFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.domainku.com

# -----------------------------------------------------------------------------
# DEMO MODE CONFIGURATION
# -----------------------------------------------------------------------------
# Set ke "true" untuk mengaktifkan:
# 1. Registrasi ditolak (HTTP 403) dengan pesan ramah
# 2. Banner info akun demo di halaman Login & Register
# 3. Proteksi akun demo utama dari penghapusan
# 4. Izin eksekusi DemoSeeder & script reset-demo.sh
# Set ke "false" untuk mode produksi normal.
DEMO_MODE=false

# Port Nginx TaskFlow pada host VPS (diteruskan oleh Caddy/Reverse Proxy)
APP_PORT=8088

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=2
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Opsi A: Menggunakan Central MariaDB di Docker (Network: shared-net)
DB_CONNECTION=mysql
DB_HOST=central-mariadb
DB_PORT=3306
DB_DATABASE=taskflow_demo
DB_USERNAME=taskflow_user
DB_PASSWORD=ChangeThisToYourDatabasePassword

# Opsi B: Menggunakan SQLite (Jika ingin serba mandiri tanpa service DB)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=taskflow_cache

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@demo.domainku.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
